[module/rofi]
type = custom/text
content =  
click-left = rofi -show drun
content-padding = ${vars.spacing}


[module/firefox]
type = custom/text
content = 
click-left = firefox &
content-padding = ${vars.spacing}


[module/term]
type = custom/text
content = 
click-left = i3-sensible-terminal &
content-padding = ${vars.spacing}


[module/files]
type = custom/text
content = 
click-left = nautilus &
content-padding = ${vars.spacing}


[module/vscode]
type = custom/text
content = 
click-left = /opt/pycharm-*/bin/pycharm.sh &
content-padding = ${vars.spacing}


[module/separator]
type = custom/text
format = " "
content-padding= 1.5


[module/wifi-module]
type = custom/script
exec = ~/.config/polybar/wifi-status.sh
interval = 5
click-left = ~/.config/polybar/wifi-menu.sh &
label = %output%
label-padding = 1


[module/bluetooth-module]
type = custom/script
exec = ~/.config/polybar/bluetooth-status.sh
interval = 5
click-left = ~/.config/polybar/bluetooth-menu.sh &
label = %output%
label-padding = 1
