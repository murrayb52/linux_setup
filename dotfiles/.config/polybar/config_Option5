; Author: Murray Buchanan
; Inspired by: https://github.com/marbinuwusito/dontfiles
;              https://www.reddit.com/r/unixporn/comments/ldicxq/i3gaps_owo/

[color]
highlight  = #aa102010
strong-highlight = #255426
background = #bb010101
text	   = #adc0b0
accent     = #548550
dark-green = #006114
orange     = #bd7023
gray       = #8dabc8

[vars]
spacing = 0
menu-spacing = 4

[bar/main]
;enable-ipc = true
width = 100%
height = 35
radius = 10
fixed-center = true
override-redirect = false

background = ${color.background}
foreground = ${color.text}

border-left-size = 10
border-right-size = 10
border-top-size = -10

padding-left = 5
padding-right = 5

module-margin-left = 1
module-margin-right = 1 

font-0 = "FontAwesome:size=12;6"
font-1 = Hack-Regular:size=10.5;6
;font-0 applies to the all icons
;font-1 applies to all bar text
modules-left = i3
modules-center = time
modules-right = wifi-module bluetooth-module
;tray-position = right
;tray-underline = ${color.c4}
line-size = 1.5


[bar/bottom]
bottom = true
background = ${color.background}
foreground = ${color.text}
width = 100%
height = 45px
;font-0 applies to icons including media buttons
font-0 = "FontAwesome:size=12;-3"
;font-1 applies to workspaces labelling and Tidal text
font-1 = "Hack-Regular:size=10.5;-3"
;font-2 applies to the Volume slider
font-2 = "FontAwesome:size=2;-5"

modules-left = cpu separator mem separator disk separator ipv4 separator local-ip
modules-right = pulseaudio battery lid power

line-size = 2
border-left-size = 10
border-right-size = 10
border-bottom-size = -15

radius = 10

padding-left = 5
padding-right = 5

module-margin-left = 1
module-margin-right = 1

[bar/external]
monitor = ${env:MONITOR:}
bottom = false
background = ${color.background}
foreground = ${color.text}
width = 100%
height = 40px
font-0 = "FontAwesome:size=11;4"
font-1 = "Hack-Regular:size=10;4"
modules-left = i3
padding-left = 3
padding-right = 3
border-left-size = 5
border-right-size = 5
border-top-size = 5
radius = 5

[module/i3]
type = internal/i3
pin-workspaces = true
index-sort = true
strip-wsnumbers = true
enable-scroll = true
enable-click = true
format = <label-state> <label-mode>

label-focused-color = ${color.text}
label-focused = %index%
label-focused-underline = ${color.text}
label-focused-background = ${color.highlight}
label-focused-padding = 4

label-unfocused = %index%
label-unfocused-overline = ${color.text}
label-unfocused-padding = 4

label-visible = %index%
label-visible-overline = ${color.text}
label-visible-padding = 1

label-urgent = %index%
label-urgent-underline = ${color.highlight}
label-urgent-background = ${color.accent}
label-urgent-padding = 1

[module/time]
type = internal/date
interval = 1
date = %a, %d %b
time = %H:%M
label = %date%  %time%
label-padding = 1


[module/power]
type = custom/menu
expand-left = true
label-open = 
label-close = 
;label-separator = " "
label-open-padding = 3
label-close-padding = 3
label-open-overline = ${color.accent}
label-close-overline = ${color.accent}
label-close-background = ${color.strong-highlight}
label-open-background = ${color.highlight}

;Poweroff menu
menu-0-0 = 
menu-0-0-padding = 2
menu-0-0-background = ${color.highlight}
menu-0-0-exec = menu-open-1
menu-0-0-overline = ${color.accent}
menu-1-0 = cancel
menu-1-0-padding = ${vars.menu-spacing}
menu-1-0-exec = menu-close
menu-1-0-overline = ${color.accent}
menu-1-1 = confirm
menu-1-1-padding = ${vars.menu-spacing}
menu-1-1-exec = poweroff &
menu-1-1-overline = ${color.accent}

;Reboot menu
menu-0-1 = 
menu-0-1-padding = 2
menu-0-1-background = ${color.highlight}
menu-0-1-exec = menu-open-2
menu-0-1-overline = ${color.accent}
menu-2-0 = cancel
menu-2-0-padding = ${vars.menu-spacing}
menu-2-0-exec = menu-close
menu-2-0-overline = ${color.accent}
menu-2-1 = confirm
menu-2-1-padding = ${vars.menu-spacing}
menu-2-1-exec = reboot &
menu-2-1-overline = ${color.accent}

;Logout menu
menu-0-2 = 
menu-0-2-padding = 2
menu-0-2-background = ${color.highlight}
menu-0-2-underline = ${color.accent}
menu-0-2-exec = menu-open-3
menu-0-2-overline = ${color.accent}
menu-3-0 = logout
menu-3-0-padding = ${vars.menu-spacing}
menu-3-0-exec = i3-msg exit
menu-3-0-overline = ${color.accent}
menu-3-1 = cancel
menu-3-1-padding = ${vars.menu-spacing}
menu-3-1-exec = menu-close
menu-3-1-overline = ${color.accent}

; Switch user menu
menu-0-3 = 
menu-0-3-padding = 2
menu-0-3-background = ${color.highlight}
menu-0-3-exec = dm-tool switch-to-greeter
menu-0-3-overline = ${color.accent}

;Lock menu
menu-0-4 = 
menu-0-4-padding = 2
menu-0-4-background = ${color.highlight}
menu-0-4-underline = ${color.accent}
menu-0-4-exec = ~/.bin/scripts/lockwallpaper.sh
menu-0-4-overline = ${color.accent}

;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Lid switch (sleep on close vs. stay awake)
;; See ~/.bin/scripts/lid-mode.sh for the underlying toggle logic.
;;;;;;;;;;;;;;;;;;;;;;;;;;;
[module/lid]
type = custom/menu
expand-left = true
label-open = ""
label-close = " ✖ "
label-open-padding = 3
label-close-padding = 3
label-open-overline = ${color.accent}
label-close-overline = ${color.accent}
label-close-background = ${color.strong-highlight}
label-open-background = ${color.highlight}

;Rocker switch: pick exactly one of the two, never both, never neither.
menu-0-0 = " Sleep"
menu-0-0-padding = ${vars.menu-spacing}
menu-0-0-background = ${color.highlight}
menu-0-0-exec = ~/.bin/scripts/lid-mode.sh sleep
menu-0-0-overline = ${color.accent}
menu-0-1 = " Awake"
menu-0-1-padding = ${vars.menu-spacing}
menu-0-1-background = ${color.highlight}
menu-0-1-exec = ~/.bin/scripts/lid-mode.sh awake
menu-0-1-overline = ${color.accent}


[module/mem]
type = internal/memory
interval = 1
label =  %gb_free%
format = <label>
label-padding = ${vars.spacing}


[module/cpu]
type = internal/cpu
interval = 1
format = <label>
label =   %percentage%%
label-padding = ${vars.spacing}


[module/temp]
type = internal/temperature
;hwmon-path = /sys/devices/pci0000:00/0000:00:18.3/hwmon/hwmon1/temp1_input
interval = 1
thermal-zone = 0
units = true
label =  %temperature-c%
warn-temperature = 60
label-warn =  %temperature-c%
label-padding = ${vars.spacing}
label-warn-padding = ${vars.spacing}


[module/disk]
type = internal/fs
mount-0 = /
interval = 10
label-mounted =  %free%
label-mounted-padding = ${vars.spacing}


[module/updates]
type = custom/script
exec = expr $(apt list --upgradable 2>/dev/null | wc -l) - 1
format = <label>
interval = 300
label = 12 %output% updates
label-padding = ${vars.spacing}


;[module/wifi]
;type = internal/network
;interface = wlp1s0
;interval = 3
;format-connected = <label-connected>
;label-connected =  %essid%
;label-connected-padding = ${vars.spacing}
;format-disconnected = <label-disconnected>
;label-disconnected =  disconnected
;label-disconnected-padding = ${vars.spacing}


[module/local-ip]
type = internal/network
interface = wlp1s0
interval = 3
format-connected = <label-connected>
label-connected =   %local_ip%
label-connected-padding = ${vars.spacing}
format-disconnected = <label-disconnected>
label-disconnected = 
label-disconnected-padding = ${vars.spacing}


;[module/ipv4]
;type = custom/script
;exec = curl -s https://ipinfo.io/ip 2>/dev/null
;interval = 30
;label =   %output%
;tail = true
;label-padding = ${vars.spacing}


[module/notification]
type = custom/text
click-left = kill -s USR1 $(pidof deadd-notification-center) &
content =  
content-padding = ${vars.spacing}
content-overline = ${color.c7}

[module/redshift]
type = custom/text
click-left = redshift -O 4500K &
click-right = redshift -x &
content = 
content-padding = 4

[module/battery]
type = internal/battery
full-at = 100
battery = BAT1
adapter = ACAD
poll-interval = 5

; Charging: keep neutral color
format-charging = <label-charging>
format-charging-padding = ${vars.spacing}
label-charging =   %percentage%%

; Discharging/Full: ramp controls icon + color, label shows percentage
format-discharging = <ramp-capacity><label-discharging>
format-discharging-padding = ${vars.spacing}
label-discharging = " %percentage%%%{F-}"

format-full = <ramp-capacity><label-full>
format-full-padding = ${vars.spacing}
label-full = " %percentage%%%{F-}"

; 10-step ramp so we can approximate 10% and 25% thresholds
;  0  =   0–9%   → red
;  1–2 = 10–29%  → orange
;  3–9 = 30–100% → normal text color
ramp-capacity-0 = "%{F#bd2c40} "
ramp-capacity-1 = "%{F#bd7023} "
ramp-capacity-2 = "%{F#bd7023} "
ramp-capacity-3 = "%{F#adc0b0} "
ramp-capacity-4 = "%{F#adc0b0} "
ramp-capacity-5 = "%{F#adc0b0} "
ramp-capacity-6 = "%{F#adc0b0} "
ramp-capacity-7 = "%{F#adc0b0} "
ramp-capacity-8 = "%{F#adc0b0} "
ramp-capacity-9 = "%{F#adc0b0} "

[module/pulseaudio]
type = internal/pulseaudio
format-volume = <label-volume>  <bar-volume>
label-volume = %percentage%%
format-volume-margin = 0
format-volume-prefix = "  "
format-volume-prefix-foreground = ${color.text}
label-volume-foreground = ${color.text}

label-muted =  Muted
label-muted-foreground = #666

bar-volume-width = 30
bar-volume-indicator =  
bar-volume-indicator-font = 0
bar-volume-fill = %{F#255426}%{F-} 
;    
bar-volume-fill-font = 3

bar-volume-empty = 
bar-volume-empty-font = 3
bar-volume-empty-foreground = ${color.text}


